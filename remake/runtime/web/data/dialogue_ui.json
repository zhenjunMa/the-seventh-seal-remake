  "font_manifest": "data/dialogue_fonts.json",
  "record_overrides": {
    "Map/m01030.TLK#19": {
      "style": 2,
      "portrait_id": 0,
      "region_byte_raw": 0,
      "speaker": 20,
      "source": {
        "path": "Map/m01030.TLK",
        "offset": 31727,
        "record_id": 19,
        "record_offset": 31672
      },
      "text_raw": "侦探：对不起，如果没有事可以请你离开，别妨碍我调查好吗？"
    },
    "Map/m01030.TLK#20": {
      "style": 1,
      "portrait_id": 27,
      "region_byte_raw": 0,
      "speaker": 1,
      "source": {
        "path": "Map/m01030.TLK",
        "offset": 33374,
        "record_id": 20,
        "record_offset": 33319
      },
      "text_raw": "调查？？请问你在调查什么呢？"
    },
    "Map/m01030.TLK#21": {
      "style": 2,
      "portrait_id": 0,
      "region_byte_raw": 0,
      "speaker": 20,
      "source": {
        "path": "Map/m01030.TLK",
        "offset": 35021,
        "record_id": 21,
        "record_offset": 34966
      },
      "text_raw": "侦探：说到这个，我可是在呼荷世界，无人不知无人不晓的名侦探。"
    },
    "Map/m01030.TLK#22": {
      "style": 1,
      "portrait_id": 35,
      "region_byte_raw": 0,
      "speaker": 2,
      "source": {
        "path": "Map/m01030.TLK",
        "offset": 36668,
        "record_id": 22,
        "record_offset": 36613
      },
      "text_raw": "侦探？那是什么东西啊！？"
    },
    "Map/m01030.TLK#23": {
      "style": 2,
      "portrait_id": 0,
      "region_byte_raw": 0,
      "speaker": 20,
      "source": {
        "path": "Map/m01030.TLK",
        "offset": 38315,
        "record_id": 23,
        "record_offset": 38260
      },
      "text_raw": "侦探：你不知道？算了！我告诉你，侦探就是专门帮人家调查一些稀奇古怪的事情。"
    },
    "Map/m01030.TLK#24": {
      "style": 1,
      "portrait_id": 37,
      "region_byte_raw": 0,
      "speaker": 2,
      "source": {
        "path": "Map/m01030.TLK",
        "offset": 39962,
        "record_id": 24,
        "record_offset": 39907
      },
      "text_raw": "调查稀奇古怪的事情？这有什么困难的，我和大姊还不是常常接受你们索摩族的请托，帮忙解决一些稀奇古怪的事情。"
    },
    "Map/m01030.TLK#25": {
      "style": 2,
      "portrait_id": 0,
      "region_byte_raw": 0,
      "speaker": 20,
      "source": {
        "path": "Map/m01030.TLK",
        "offset": 41609,
        "record_id": 25,
        "record_offset": 41554
      },
      "text_raw": "侦探：看样子，你是不相信我的能力啰！总有一天，你会来拜托我的，如果没事我可要继续执行我的任务了。"
    },
    "Map/m01030.TLK#26": {
      "style": 1,
      "portrait_id": 0,
      "region_byte_raw": 0,
      "speaker": 20,
      "source": {
        "path": "Map/m01030.TLK",
        "offset": 43256,
        "record_id": 26,
        "record_offset": 43201
      },
      "text_raw": "侦探：别忘了，想要我调查的话，记得来找我啊！"
    }
  },
