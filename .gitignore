# Track source and structured runtime definitions, not arbitrary game files.
*
!*/
!*.py
!*.mjs
!*.js
!*.json
!*.html
!*.css
!*.md
!*.txt
!*.ps1
!*.sh
!*.toml
!*.yaml
!*.yml
!*.ini
!*.cfg
!*.csv
!*.svg

# The repository lives alongside a local original-game installation.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/remake/

# Extracted media, source observations, reports, and historical snapshots.
/remake/**/assets/
# Original text, source records and runtime tables are reconstructed locally.
/remake/runtime/web/data/**/*.json
!/remake/runtime/web/data/config/**/*.json
!/remake/runtime/web/data/source/**/*.json
!/remake/runtime/web/data/events/**/*.json
!/remake/runtime/web/data/runtime_content.json
!/remake/runtime/web/data/content_checklist.json
!/remake/runtime/web/data/battle_result.json
!/remake/runtime/tools/data_recipes/*.json.gz
/remake/observation/
/remake/**/evidence/
/remake/archive/
/remake/assessment/*.json

# Local environments, caches, editor state, and credentials.
**/__pycache__/
**/node_modules/
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.cache/
**/.vscode/
**/.idea/
**/.agents/
**/.codex/
**/.env
**/.env.*
**/*credentials*
**/*secret*

# Save files and captured or extracted binaries are never source definitions.
*.dat
*.Dat
*.DAT
*.sav
*.SAV
*.exe
*.dll
*.dgp
*.CHR
*.ITM
*.ANM
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.bmp
*.ico
*.wav
*.ogg
*.mp3
*.mp4
*.webm
*.avi
*.ttf
*.otf
*.woff
*.woff2
*.zip
*.7z
*.log
*.pid
*.pyc
*.pyo
*.bak
*.tmp

# Track remake player saves, including their binary files.
!/remake/saves/**

# Versioned, generated glyph atlases are built-in remake resources.
!/remake/runtime/builtin/fonts/**/*.png

# Gameplay screenshots used in the root README.
!/remake/docs/screenshots/*.webp

# Windows batch launchers are user-local wrappers.
*.[cC][mM][dD]
*.[bB][aA][tT]
